# Public Supabase (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: API routes (leads, campaigns, import, logging). Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — optional; email/ad routes use templates if empty
OPENAI_API_KEY=

# Google Places — server-only; enables Lead Finder real provider search
GOOGLE_PLACES_API_KEY=

# Resend — transactional / outbound
RESEND_API_KEY=
# Fallback "from" when no row in public.inboxes for the lead’s organization (still required by Resend SDK)
RESEND_FROM_EMAIL=
# Resend → Webhooks signing secret (enables POST /api/webhooks/resend — inbound replies, bounces)
RESEND_WEBHOOK_SECRET=

# Optional: cap bulk sends per hour (counts outreach_logs event_type=send)
OUTBOUND_MAX_SENDS_PER_HOUR=100

# Optional: Vercel Cron hits /api/cron/drain-queue with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
